# Modelo de .env para rodar o sistema numa VM com Docker Compose.
# Copie para ".env" na mesma pasta do docker-compose.yml e preencha.
# NUNCA versione o .env (ele já está no .gitignore).

# --- Django ---
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=TROCAR_POR_CHAVE_ALEATORIA_DE_50_OU_MAIS_CARACTERES
DEBUG=false
DJANGO_ALLOWED_HOSTS=10.11.10.10,estoque.clearit.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=http://10.11.10.10,https://estoque.clearit.com.br
# Acesso por http://10.11.10.10 => cookies seguros DESLIGADOS (senão o login não funciona).
# Ligue (true) só quando o acesso for exclusivamente por HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_LOG_LEVEL=INFO

# --- Banco (Postgres no próprio Compose) ---
# Ao restaurar um dump da VM antiga, use o MESMO nome de banco/usuário de lá
# (ou restaure com --no-owner, como no guia DEPLOY-VM.md).
DATABASE_NAME=postgres_db_stock
DATABASE_USER=clear_stock
DATABASE_PASSWORD=TROCAR_POR_SENHA_FORTE

# --- Porta publicada na VM (http://10.11.10.10) ---
APP_PORT=80

# --- Gunicorn: nº de processos (2 a 4 por vCPU) ---
WEB_CONCURRENCY=3
